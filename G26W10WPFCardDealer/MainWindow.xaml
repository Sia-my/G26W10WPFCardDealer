<Window x:Class="G26W10WPFCardDealer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:G26W10WPFCardDealer"
        mc:Ignorable="d"
        Title="카드 딜러 - 포커 족보 판별 (WPF)" Height="900" Width="1220">
    <!-- [과제 변경] 제목 변경, 확률표가 들어가도록 창 크기 450x800 → 900x1220 -->

    <Window.Resources>
        <!-- [과제 변경] bool(IsCurrent) → Visibility 변환 (WPF 기본 제공 Converter) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Border Padding="5" Background="#040">
        <DockPanel>
            <Button
                DockPanel.Dock="Bottom"
                x:Name="BtnDeal"
                Content="카드 분배"
                FontSize="18"
                Padding="8"
                Margin="16"
                Command="{Binding DealCardsCommand}"/>

            <!-- [과제 변경] 전체 족보 확률표 추가 : DataTrigger 로 현재 패의 족보 행을 강조 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="16,0">
                <DataGrid
                    x:Name="GridProbabilities"
                    ItemsSource="{Binding Probabilities}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    FontSize="14">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Background" Value="LightYellow"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="족보" Binding="{Binding Name}" Width="3*"/>
                        <DataGridTextColumn Header="경우의 수" Binding="{Binding CountText}" Width="2*"/>
                        <DataGridTextColumn Header="확률" Binding="{Binding ProbabilityText}" Width="2*"/>
                        <DataGridTemplateColumn Header="현재 패" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="◀ 현재 패"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding TotalText}" Foreground="White" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- [과제 변경] 족보 판별 결과 TextBlock 2개 추가 -->
            <TextBlock
                DockPanel.Dock="Bottom"
                Text="{Binding InfoText}"
                Foreground="White"
                FontSize="15"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"/>
            <TextBlock
                DockPanel.Dock="Bottom"
                Text="{Binding ResultText}"
                Foreground="Gold"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,8"/>

            <!-- 카드 5장 (수업 ItemsControl 그대로) -->
            <ItemsControl ItemsSource="{Binding CardResource}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- [과제 변경] Stretch None → Uniform : 창 크기에 맞춰 카드 크기 조절 -->
                        <Image Stretch="Uniform" Margin="4" Source="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
